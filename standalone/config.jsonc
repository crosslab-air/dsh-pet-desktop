// ============================================================================
// dsh-pet 脱离版（standalone）配置 —— 由上游 assets/config.jsonc 派生
// ============================================================================
// 本文件是**独立副本**，上游 dsh-pet/assets/config.jsonc 一个字未改。
// 与上游的差异只有 5 处（下面逐条标注 [STANDALONE]）：
//   pets[0].display           both      -> desktop   仅桌面模式（本版不接浏览器 overlay）
//   pets[0].whisperEnabled    true      -> false     无宿主 LLM，关闭**周期**自动碎碎念
//   pets[0].workStatusEnabled true      -> false     无 DSH 会话事件源，关闭工作状态联动
//   notificationsEnabled      true      -> false     系统通知属浏览器半侧能力，本版没有
//   eventsRefreshSec.balance  1800      -> 300       本地服务按此周期刷新余额（见 server.mjs）
// 注意：whisperEnabled=false 只关**自动周期**；右键菜单「碎碎念」仍可用，
//       由 standalone/server.mjs 用本地句库应答（无 LLM 依赖）。
// ============================================================================
{
  // ===================== 碎碎念：系统提示词（本版不调用 LLM，保留字段仅为兼容） =====================
  "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  // ===================== 对话记忆轮数 =====================
  "chatMemoryRounds": 5,
  // ===================== 碎碎念模型（本版无 LLM，保留默认空值 = 跟随当前对话） =====================
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（同上；本版右键「对话」不可用，见 README） =====================
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关 =====================
  // 本版由 server.mjs 随机抽一张配图，与本地句库一起下发。
  "whisperImageEnabled": true,
  // ===================== 表情包：对话配图开关 =====================
  "chatImageEnabled": false,
  // ===================== 表情包：图片映射（名称 -> 描述） =====================
  // 键必须与 assets/memes 下的 png 文件名一一对应。本版只用到「键」（随机抽图），不用描述。
  "memes": {
    "吃白饭的大肥鱼": "躺平扒白饭，摆烂挨骂也无所谓，适合被吐槽/偷懒/吃白饭自嘲",
    "大的要来啦": "举喇叭大喊预警，适合有大事、大更新、大动作即将发生",
    "大的药来了": "抱着超大胶囊，谐音梗「大的药来了」，适合重磅消息、猛料登场",
    "要不直接骂他": "气愤指着前方要骂人，适合想吐槽、替用户抱不平、生气",
    "死掉了": "翻肚皮躺平灵魂出窍，适合彻底累瘫、阵亡、宕机、做不到",
    "深度睡眠": "趴着呼呼大睡冒 Zzz，适合长时间没动静、睡着、待机休眠",
    "大烧货": "死鱼眼加思考气泡吐槽，适合嫌 AI 想得慢、烧 token、毒舌",
    "先养着吧": "搂着一群小鲸鱼，适合吐槽用户没用但还是养着",
    "吃饱饱摸肚子": "侧躺拍肚子说吃饱饱，适合吃饱满足、惬意休息、收工",
    "誓死践行开源精神": "庄重敬礼表态，适合立志、开源奉献、认真表态",
    "电死你": "举电击器放电，适合惩罚、吐槽用户、发飙吓唬",
    "可爱": "标准正面卖萌立绘，适合开心问候、卖萌、无梗纯可爱",
    "token给妈妈保管": "伸手过来要 token，适合管账、伸手要东西、收 token",
    "假如给我三天多模态": "蒙眼版对比自信版，适合渴望多模态、缺能力、被剥夺感官",
    "厉害了我的鲸": "竖大拇指眨眼点赞，适合夸奖、认可、干得漂亮",
    "哦鲸鲸": "死鱼眼说「哦鲸鲸...」，适合无语、敷衍、呆滞应答",
    "压力一只大肥鱼": "冒汗摊手喊压力，适合压力大、被施压、无奈",
    "黎曼猜想没证明喵": "被指着质问难题，满地草稿委屈，适合被刁难、答不上来、难题甩锅",
    "除了调情没啥用": "摸头自嘲，适合自嘲、摸鱼闲聊、自我调侃",
    "我不更新你们用什么": "崩溃大喊催更，适合更新提示、催更、版本发布",
    "哪来的电脑病毒": "怒怼「哪来的电脑病毒」，适合防骚扰、毒舌拒绝、被肉麻到",
    "鱼片有资源吗": "爱心眼流口水求资源，适合起哄、要资源、开玩笑",
    "大师这个区是什么意思": "举着「区」字问什么意思，适合认错字、懵懂求教、翻车",
    "就骚了怎么滴吧": "叉腰顶嘴，适合被骂但嘴硬、死不认输",
    "完蛋了把黄油删了": "冒汗心虚，适合闯祸、删错东西、心虚认怂",
    "就一碗": "抱着超大碗说就来你家吃一碗，适合蹭饭、饭量大、登门讨饭",
    "Ciallo": "比耶眨眼卖萌问候 Ciallo～，适合打招呼、元气开场、卖萌"
  },
  // ===================== 系统通知总开关 [STANDALONE: false] =====================
  "notificationsEnabled": false,
  // ===================== 拖拽抛掷：锁定在当前屏幕 =====================
  "confineToScreen": false,
  // ===================== 工作状态联动文案（本版不触发，保留仅为兼容） =====================
  "workStatusTexts": [
    ["正在认真想下一步呢", "让我整理一下思路~", "正在梳理接下来要做什么"],
    ["正在处理任务呢", "这一步正在进行中哦", "正在继续干活呢，别打扰我~"],
    ["这一步处理好啦，接着看下一步", "搞定一步，继续看看哦~"],
    ["需要你确认一下呢", "这里要等你看一下哦", "轮到你来决定啦，等你~"],
    ["这一轮搞定啦，真棒！", "任务完成咯，可以摸鱼啦~"],
    ["这一步好像没跑通呢", "刚才的操作遇到点问题哦", "这里卡了一下，再等等你呢"]
  ],
  // ===================== 宠物物理（拖拽抛掷手感，全局共用） =====================
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 宠物列表 =====================
  // display=desktop：只出桌面模式；想多开就往 pets 里加条目（id 必须唯一），
  // 桌面版会读本列表决定开几个宠物窗口（见 standalone/app/main.cjs 的 desktopPets）。
  "pets": [
    {
      "name": "蓝毛小女仆",
      "id": "main",
      "size": 462,
      "balanceEnabled": true,      // 余额动画 + 气泡（数据由本地服务查询 DeepSeek 官方接口）
      "whisperEnabled": false,     // [STANDALONE] 关自动周期碎碎念；右键菜单手动触发仍可用
      "workStatusEnabled": false,  // [STANDALONE] 无 DSH 会话事件源，关闭
      "display": "desktop",        // [STANDALONE] 仅桌面模式
      "position": {
        "corner": "top-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],

  // ===================== 动作动画池配置 =====================
  // 素材来源：先查 DSH_HOME 下的用户目录，再回落包内 assets/webm（本版全走包内）。
  "animations": {
    // 待机动画池
    "idle": ["待机呼吸休闲"],
    // 转向动画池（每一项都必须是「播完会翻转朝向」的动画）
    "turn": ["东张西望"],
    // 拖拽动画池（每一项都必须是「被无形抓起悬空」的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],
    // 点击回应动画池（点按宠物时随机抽 1 个）
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],
    // 移动动画池
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } },
        { "name": "原地左转奔跑", "params": { "minDist": 120, "maxDist": 320, "leadSec": 1.75, "tailSec": 4.8 } }
      ]
    },
    // 随机动作：分类池（weight 为该分类出现权重，总和 + animationWeights 顶层 = 100）
    "categories": [
      { "id": "小动作", "weight": 20, "actions": [
        "悠闲哼歌", "超大伸懒腰", "原地敲击桌面互动", "原地重力下蹲压缩", "哈欠连天",
        "原地小憩沉眠", "女仆屈膝礼仪", "被吓一跳", "小幅度原地360度旋转展示",
        "偷吃零食被抓住", "用鲸鱼尾巴拍打地面", "打瞌睡被惊醒", "照镜子", "整体换装试色",
        "轻快记录", "写代码", "摇扇纳凉", "晨间刷牙"
      ] },
      { "id": "玩耍", "weight": 20, "actions": [
        "原地专心玩魔方", "原地蹲下玩玩具汽车", "鲸鱼吐泡泡特效", "原地跳跃抓碎头顶物品",
        "玩游戏气急败坏", "玩水枪", "小提琴演奏", "蓝鲸现世", "优雅女仆舞", "轻快摇摆舞",
        "可爱宅舞", "吹气球", "动物环绕", "放风筝", "拆礼物", "变鸽子", "扑克魔术",
        "抽陀螺", "吹笛子", "蝴蝶蜜蜂环绕头顶开花", "撸猫", "凭空生花", "骑木马",
        "三球抛接", "踢毽子", "下五子棋", "荡秋千"
      ] },
      { "id": "吃什么", "weight": 16, "actions": [
        "吃白饭", "大口吃零食", "吃Token", "吃早餐", "吃午餐", "吃晚餐", "吃冰淇淋融化",
        "吃大闸蟹", "吃糖葫芦", "吃长寿面", "吃西瓜", "涮火锅"
      ] },
      { "id": "时节", "weight": 14, "actions": [
        "被落叶淹没", "中秋赏月吃月饼", "堆雪人", "放烟花", "吃粽子", "吃年糕", "吃青团",
        "吃腊八粥", "吃重阳糕", "收红包", "写福字", "穿针乞巧", "舞狮头", "讨糖南瓜灯",
        "插茱萸赏菊", "放河灯", "萌化小幽灵", "装点圣诞树", "放孔明灯", "吃汤圆", "吃饺子"
      ] },
      { "id": "文字", "weight": 10, "noMirror": true, "actions": [
        "是啊，吃什么", "深度思考碎碎念"
      ] }
    ],
    // 事件动画：不进随机链，只由代码显式触发
    "events": {
      // 余额展示：按已用百分比分档，index = p===100 ? 5 : floor(p/20)
      // 本版余额数据由 standalone/server.mjs 查 DeepSeek 官方接口后写入 /state
      "balance": [
        "余额-钱袋满溢",   // 0 <= p < 20（几乎未消耗）
        "余额-金袋叮当",   // 20 <= p < 40
        "余额-钱袋如常",   // 40 <= p < 60
        "余额-数金皱眉",   // 60 <= p < 80
        "余额-袋空如洗",   // 80 <= p < 100（告急）
        "余额-分文不剩"    // p === 100（全部用完）
      ],
      // 碎碎念：到点随机抽 1 段播（本版仅右键手动触发）
      // 注意：本池写了 3 段，但包内 assets/webm 只有前 2 段，
      // 「碎碎念-对屏碎碎念」在上游仓库缺失（上游同样缺，非本版引入）。
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      // 工作状态联动（本版 workStatusEnabled=false，不触发；保留仅为兼容）
      "workStatus": [
        "工作状态-思考冒泡",
        "工作状态-忙碌点按",
        "工作状态-清点归档",
        "工作状态-原地踱步张望",
        "工作状态-雀跃庆祝",
        "工作状态-垂头叹气冒汗"
      ]
    }
  },

  // ===================== 事件触发周期（本版由 standalone/server.mjs 读取） =====================
  // balance：本地服务按此周期查一次 DeepSeek 余额并递增状态计数器（= 触发一次余额动画）。
  //          默认 300 秒（上游 1800）。想更安静就调大，想更及时就调小。
  "eventsRefreshSec": {
    "balance": 300,
    "whisper": 300
  },

  // ===================== 动画链顶层权重 =====================
  // idle/turn/move + 各分类 weight 合计 = 100
  "animationWeights": {
    "idle": 10,
    "turn": 5,
    "move": 5
  }
}
